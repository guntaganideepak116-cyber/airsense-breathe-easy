# ==================================================
# AirSense IoT System - Environment Variables
# ==================================================

# ── MongoDB Database ──
# Connection string for your MongoDB database (local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/airsense?retryWrites=true&w=majority

# ── Clerk Authentication ──
# Clerk publishable key for client-side authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk secret key for server-side token verification and API protection
CLERK_SECRET_KEY=sk_test_...


# ── Email Notifications (Resend) ──
# Resend API key for HTML email notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender email address
ALERT_FROM_EMAIL=AirSense Alerts <alerts@yourdomain.com>
# Default fallback recipient email
ALERT_TO_EMAIL=your_email@example.com

# ── Outdoor Weather & AQI ──
# Open-Meteo is used by default and does not require an API key.
# If using an optional weather provider (e.g. OpenWeatherMap), configure below:
WEATHER_API_KEY=

# ── AI Recommendation Engine ──
# AI Provider: groq (recommended free tier), gemini, or openai
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_API_KEY=
AI_RECOMMENDATION_COOLDOWN_SECONDS=300

# ── Application Environment ──
NODE_ENV=production
VITE_API_URL=
